<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_custom_fleet" model="res.groups.privilege">
        <field name="name">Company Vehicles (standalone)</field>
        <field name="sequence">19</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_custom_fleet_user" model="res.groups">
        <field name="name">Base User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_custom_fleet"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Sees and edits only the vehicles assigned to himself; can register new ones for himself. Cannot delete or reassign them.</field>
    </record>

    <record id="group_custom_fleet_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_custom_fleet"/>
        <field name="implied_ids" eval="[Command.link(ref('group_custom_fleet_user'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
        <field name="comment">Sees and manages all the vehicles.</field>
    </record>

    <data noupdate="1">
        <record id="rule_custom_fleet_vehicle_company" model="ir.rule">
            <field name="name">Company Vehicles: multi-company</field>
            <field name="model_id" ref="model_custom_fleet_vehicle"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_custom_fleet_vehicle_user_own" model="ir.rule">
            <field name="name">Company Vehicles: Base User sees only his own vehicles</field>
            <field name="model_id" ref="model_custom_fleet_vehicle"/>
            <field name="groups" eval="[Command.link(ref('group_custom_fleet_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Group rules are OR-ed: this widens the Base User rule inherited by the Manager. -->
        <record id="rule_custom_fleet_vehicle_manager_all" model="ir.rule">
            <field name="name">Company Vehicles: Manager sees all vehicles</field>
            <field name="model_id" ref="model_custom_fleet_vehicle"/>
            <field name="groups" eval="[Command.link(ref('group_custom_fleet_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
