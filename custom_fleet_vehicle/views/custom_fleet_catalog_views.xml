<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="custom_fleet_vehicle_brand_view_list" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.brand.list</field>
        <field name="model">custom.fleet.vehicle.brand</field>
        <field name="arch" type="xml">
            <list string="Brands" editable="bottom">
                <field name="image_128" widget="image" options="{'size': [0, 32]}" optional="show"/>
                <field name="name"/>
                <field name="model_count"/>
            </list>
        </field>
    </record>

    <record id="custom_fleet_vehicle_brand_view_form" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.brand.form</field>
        <field name="model">custom.fleet.vehicle.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Fiat"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="model_ids">
                        <list editable="bottom">
                            <field name="name"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="custom_fleet_vehicle_brand_view_search" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.brand.search</field>
        <field name="model">custom.fleet.vehicle.brand</field>
        <field name="arch" type="xml">
            <search string="Search Brands">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_custom_fleet_vehicle_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">custom.fleet.vehicle.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first vehicle brand</p>
        </field>
    </record>

    <record id="custom_fleet_vehicle_model_view_list" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.model.list</field>
        <field name="model">custom.fleet.vehicle.model</field>
        <field name="arch" type="xml">
            <list string="Models" editable="bottom">
                <field name="image_128" widget="image" options="{'size': [0, 32]}" optional="show"/>
                <field name="brand_id" options="{'no_create': True}"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="custom_fleet_vehicle_model_view_form" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.model.form</field>
        <field name="model">custom.fleet.vehicle.model</field>
        <field name="arch" type="xml">
            <form string="Model">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <group>
                        <field name="brand_id"/>
                        <field name="name" placeholder="e.g. Panda"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="custom_fleet_vehicle_model_view_search" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.model.search</field>
        <field name="model">custom.fleet.vehicle.model</field>
        <field name="arch" type="xml">
            <search string="Search Models">
                <field name="name"/>
                <field name="brand_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Brand" name="groupby_brand" context="{'group_by': 'brand_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_custom_fleet_vehicle_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">custom.fleet.vehicle.model</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first vehicle model</p>
            <p>Every model belongs to a brand.</p>
        </field>
    </record>

    <record id="custom_fleet_vehicle_color_view_list" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.color.list</field>
        <field name="model">custom.fleet.vehicle.color</field>
        <field name="arch" type="xml">
            <list string="Colors" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="custom_fleet_vehicle_color_view_search" model="ir.ui.view">
        <field name="name">custom.fleet.vehicle.color.search</field>
        <field name="model">custom.fleet.vehicle.color</field>
        <field name="arch" type="xml">
            <search string="Search Colors">
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_custom_fleet_vehicle_color" model="ir.actions.act_window">
        <field name="name">Colors</field>
        <field name="res_model">custom.fleet.vehicle.color</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the first vehicle color</p>
        </field>
    </record>
</odoo>
