<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_vehicle_view_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.employee.access</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="hr_fleet.fleet_vehicle_view_form_inherit_hr"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='driver_employee_id']" position="attributes">
                <attribute name="invisible">0</attribute>
                <attribute name="string">Employee</attribute>
                <attribute name="widget">many2one_avatar_employee</attribute>
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
            <!-- Fields split by group: only Managers may create models on the fly. -->
            <xpath expr="//field[@name='model_id']" position="attributes">
                <attribute name="groups">fleet.fleet_group_user</attribute>
                <attribute name="options">{'no_quick_create': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='model_id']" position="after">
                <field name="model_id" placeholder="e.g. Model S" class="w-100"
                       options="{'no_create': True}" groups="!fleet.fleet_group_user"/>
            </xpath>
            <xpath expr="//field[@name='color']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='color']" position="after">
                <field name="color_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       groups="fleet.fleet_group_user"/>
                <field name="color_ids" widget="many2many_tags"
                       options="{'color_field': 'color', 'no_create': True}"
                       groups="!fleet.fleet_group_user"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_list" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.employee.access</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="hr_fleet.fleet_vehicle_view_tree_inherit_hr"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='driver_employee_id']" position="attributes">
                <attribute name="string">Employee</attribute>
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="before">
                <field name="color_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_view_search" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.employee.access</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='model_id']" position="before">
                <field name="driver_employee_id" string="Employee"/>
                <field name="color_ids" string="Color"/>
            </xpath>
            <xpath expr="//filter[@name='available']" position="before">
                <filter string="My Vehicles" name="my_vehicles"
                        domain="[('driver_employee_id.user_id', '=', uid)]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='groupby_model']" position="before">
                <filter string="Employee" name="groupby_employee" context="{'group_by': 'driver_employee_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="fleet_vehicle_my_action" model="ir.actions.act_window">
        <field name="name">My Vehicles</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_my_vehicles': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first vehicle</p>
            <p>The vehicles assigned to your employee are listed here.</p>
        </field>
    </record>

    <menuitem id="fleet_vehicle_my_menu" name="My Vehicles"
              parent="fleet.fleet_vehicles" action="fleet_vehicle_my_action"
              sequence="1" groups="group_fleet_own_vehicles"/>
</odoo>
